FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// Step 0 baseline: stock OpenFOAM CPU linear solvers only.
// No Paralution / OpenCL / CUDA / HIP.
//
// Swap to GAMG for larger meshes:
//   cp system/fvSolution.GAMG system/fvSolution
//

solvers
{
    T
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-08;
        relTol          0.01;
    }

    TFinal
    {
        $T;
        relTol          0;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
}

